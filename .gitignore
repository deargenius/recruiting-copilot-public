# Release allowlist: local documents and exports stay on this computer.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/requirements-dev.txt
!/*.py
!/*.cmd
!/*.ps1
!/static/
/static/*
!/static/*.html
!/static/*.css
!/static/*.js
!/assets/
/assets/*
!/assets/README.md
!/data/
/data/*
!/data/.gitkeep

# Secrets, runtime data and generated documents must never be committed.
**/.env
**/.env.*
**/*credentials*
**/*secret*
**/*.pem
**/*.key
**/*.pfx
**/*.sqlite*
**/*.db
**/*.db-*
**/*.docx
**/*.doc
**/*.pdf
**/*.xlsx
**/*.csv
**/*.zip
**/*.png
**/*.jpg
**/*.jpeg
**/*.log
**/*.pid
**/*.pyc
**/__pycache__/
**/.venv/
**/node_modules/
.release-audit/
